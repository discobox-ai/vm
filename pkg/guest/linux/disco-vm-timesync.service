[Unit]
Description=Step the guest clock to the host-backed RTC
# Only a host-backed RTC can answer this (Virtualization.framework's PL031).
# Without one the timer would write to the serial console every 30 seconds.
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/disco-vm-sync-clock
StandardOutput=journal+console
StandardError=journal+console
