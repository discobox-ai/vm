#!/bin/sh
# initramfs-tools build hook: put cp and chmod in the initrd, which the
# init-bottom hook disco-vm-agent needs to move the agent a boot appends. An
# initrd with no busybox has klibc's tools alone, and those have neither.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions
copy_exec /usr/bin/cp /bin
copy_exec /usr/bin/chmod /bin
