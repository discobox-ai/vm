# What disco-vm's Linux guest needs of the libkrun kernel (ADR 26-11-03-530
# §5) beyond libkrunfw's own configuration, which boots a virtiofs root with
# libkrun's init and no initrd. Merged over config-libkrunfw_x86_64; the build
# fails if olddefconfig drops any of these.
#
# The guest's initramfs-tools initrd, zstd-compressed, which runs the hook that
# moves the agent a boot appends, and mounts the ext4 root on /dev/vda.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
# systemd mounts its API filesystems through autofs units.
CONFIG_AUTOFS_FS=y
# The root's ACLs, which systemd-journald and tmpfiles set.
CONFIG_EXT4_FS_POSIX_ACL=y
# The full PID space: libkrunfw's BASE_SMALL caps pid_max at 32768, and
# systemd-sysctl sets it to 4194304.
# CONFIG_BASE_SMALL is not set
# No dummy0: a guest with no network device has only lo.
# CONFIG_DUMMY is not set
# nftables (discobox ADR 26-11-11-963 §6): a user of the base fences its
# network with an inet rule set that admits only replies to the guest's own
# connections, which needs connection tracking. libkrunfw builds these in.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
# A hard-lockup detector, which libkrunfw leaves out, so the command line's
# nmi_watchdog=panic,1 resets a guest whose CPU stops taking interrupts, as it
# does on vz's arm64 Debian kernel. The buddy detector, Debian arm64's, which
# needs no guest PMU: each CPU checks the next one's hrtimer interrupts. It
# brings the soft-lockup detector, which only warns.
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_SOFTLOCKUP_DETECTOR=y
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
