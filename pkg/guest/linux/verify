#!/bin/sh
# Check an assembled artifact set before it is published: a kernel the
# hypervisor loads, a root that mounts as disco-vm expects, and an initrd that
# moves the agent a boot appends. A broken one otherwise fails as a blank
# console on a host that cannot be debugged from.
set -eu

out=${1:?usage: verify OUTPUT_DIR}
arch=${TARGETARCH:?verify: TARGETARCH must be set}
fail() {
    echo "verify: $*" >&2
    exit 1
}

case "$arch" in
arm64) [ "$(dd if="$out/vmlinux" bs=1 skip=56 count=4 2>/dev/null)" = "ARMd" ] || fail "vmlinux is not an arm64 Image" ;;
amd64)
    [ "$(dd if="$out/vmlinux" bs=1 skip=1 count=3 2>/dev/null)" = "ELF" ] || fail "vmlinux is not an ELF kernel"
    # libkrun's kernel (ADR 26-11-03-530 §5): an x86-64 ELF, which libkrun
    # loads as an external kernel. Only booting it proves more.
    [ "$(dd if="$out/krun/vmlinux" bs=1 skip=1 count=3 2>/dev/null)" = "ELF" ] || fail "krun/vmlinux is not an ELF kernel"
    [ "$(od -An -tx1 -j18 -N2 "$out/krun/vmlinux" | tr -d ' ')" = "3e00" ] || fail "krun/vmlinux is not an x86-64 kernel"
    ;;
esac

[ "$(e2label "$out/root.ext4")" = "disco-vm-root" ] || fail "root.ext4 is not labeled disco-vm-root"
has() { debugfs -R "stat $1" "$out/root.ext4" 2>/dev/null | grep -q "^Inode:" || fail "root.ext4 has no $1"; }
has /etc/systemd/system/disco-vm-guest.service
has /etc/systemd/system/multi-user.target.wants/disco-vm-guest.service
has /etc/systemd/system/systemd-networkd-wait-online.service.d/10-disco-vm.conf
has /etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service
has /etc/systemd/network/10-disco-vm.network
has /usr/local/sbin/disco-vm-sync-clock
# nftables: the tool, the unit that loads /etc/nftables.conf before the network
# comes up, enabled, and Debian's kernel's modules for nf_tables and connection
# tracking (libkrun's kernel builds them in, which its build checks).
has /usr/sbin/nft
has /etc/nftables.conf
has /etc/systemd/system/sysinit.target.wants/nftables.service
modules=$(debugfs -R "ls -p /usr/lib/modules" "$out/root.ext4" 2>/dev/null | awk -F/ '$6 != "." && $6 != ".." && $6 != "" { print $6 }')
[ -n "$modules" ] && [ "$(echo "$modules" | wc -l)" = 1 ] || fail "root.ext4 has not exactly one kernel's modules: ${modules:-none}"
# The kernel is vmlinux, loaded from the host; a copy in the root is dead
# weight.
! debugfs -R "stat /usr/lib/modules/$modules/vmlinuz" "$out/root.ext4" 2>/dev/null | grep -q "^Inode:" || fail "root.ext4 carries the kernel at /usr/lib/modules/$modules/vmlinuz"
# A rule set admitting only replies needs connection tracking (ct state).
for module in nf_tables nft_ct nf_conntrack; do
    has "/usr/lib/modules/$modules/kernel/net/netfilter/$module.ko.xz"
done
debugfs -R "cat /etc/fstab" "$out/root.ext4" 2>/dev/null | grep -q "^/dev/vda / ext4 rw,x-systemd.growfs" || fail "fstab does not grow the root"
size=$(debugfs -R "stat /etc/machine-id" "$out/root.ext4" 2>/dev/null | sed -n 's/.*Size: \([0-9]*\).*/\1/p' | head -n1)
[ "$size" = "0" ] || fail "/etc/machine-id is not empty"

# The initrd's main archive, its last, is zstd, as initramfs.conf asks
# (COMPRESS=zstd): update-initramfs falls back to gzip, with only a warning,
# when the root has no zstd. 3cpio, which sid's mkinitramfs builds with, lists
# each archive's compression after any uncompressed early ones (modules
# already compressed, .ko.xz; microcode), which it pads to 4 bytes, not 512.
archives=$(3cpio --examine --raw "$out/initrd.img") || fail "the initrd does not read"
compression=$(printf '%s\n' "$archives" | tail -n 1 | cut -f 4)
[ "$compression" = "zstd" ] || fail "the initrd's main archive is ${compression:-unreadable}, not zstd, as initramfs.conf asks"

contents=$(lsinitramfs "$out/initrd.img")
for want in scripts/init-bottom/disco-vm-agent bin/cp bin/chmod; do
    echo "$contents" | grep -q "^\(usr/\)\?$want$" || fail "the initrd has no $want, which moving the agent needs"
done
echo "verify: $out is a disco-vm Linux guest for $arch"
