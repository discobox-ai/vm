<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Creating a Virtualization.framework VM requires this entitlement, and it
	  exists only on a signed binary, so every build is re-signed (make build).
	  Ad-hoc signing is enough locally; distribution needs Developer ID and
	  notarization.

	  com.apple.vm.networking is deliberately absent: it is needed only for
	  bridged networking. The vz driver uses the framework's NAT.
	-->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
